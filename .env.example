# Copy to .env and fill in. NEVER commit .env.

# Snowflake (Part B)
# Account identifier: Snowsight -> your name (bottom left) -> Account -> View account details
# -> copy the "Account identifier" (looks like <orgname>-<accountname>). Do NOT include https://
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=<your-snowflake-username>
# Your password, or a programmatic access token if MFA blocks plain passwords.
SNOWFLAKE_PASSWORD=<your-password-or-token>
SNOWFLAKE_WAREHOUSE=FRESHCART_WH
SNOWFLAKE_DATABASE=FRESHCART_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_ROLE=ACCOUNTADMIN

# RabbitMQ (Part D)
RABBITMQ_URL=
